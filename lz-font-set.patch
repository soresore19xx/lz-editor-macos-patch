+fn usable_font(path: &Path, index: u32, accept: fn(&FaceMetrics) -> bool) -> Option<FontRef> {
+    let bytes = std::fs::read(path).ok()?;
+    let face = Face::parse(&bytes, index).ok()?;
+    if !accept(&face_metrics(&face)?) {
