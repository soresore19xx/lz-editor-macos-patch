+/// Apply the saved set at startup; fall back to auto-detection if a saved font is unusable.
+pub fn apply_or_auto(ctx: &egui::Context, set: &FontSet) -> Option<String> {
+    let err = apply(ctx, set).err()?;
+    let _ = apply(ctx, &FontSet::default());
+    Some(err)
+}
