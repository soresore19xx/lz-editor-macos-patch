+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+
+    fn entry(name: &str, has_ja: bool, ascii_mono: bool, ja_mono: bool) -> FontEntry {
+        FontEntry {
+            font: FontRef {
+                path: PathBuf::from(format!("/nonexistent/{name}")),
+                index: 0,
+                name: name.to_string(),
+            },
+            has_ja,
+            ascii_mono,
+            ja_mono,
+        }
+    }
+
+    fn picker() -> FontPicker {
+        FontPicker::with_entries(
+            &FontSet::default(),
+            vec![
+                entry("JaMono", true, true, true),
+                entry("JaProp", true, false, false),
+                entry("Latin", false, true, false),
+            ],
+        )
+    }
+
+    fn press(p: &mut FontPicker, key: Key) -> Option<PickerOutcome> {
+        let ctx = egui::Context::default();
+        let input = egui::RawInput {
+            events: vec![Event::Key {
+                key,
+                physical_key: None,
+                pressed: true,
+                repeat: false,
+                modifiers: egui::Modifiers::NONE,
+            }],
+            ..Default::default()
+        };
+        let mut out = None;
+        let _ = ctx.run(input, |ctx| out = p.handle_keys(ctx));
+        out
+    }
+
+    #[test]
+    fn test_lists_filter_and_selection() {
+        let mut p = picker();
+        assert_eq!(p.row_count(Pane::Ascii), 4); // auto, same, JaMono, Latin
+        assert_eq!(p.row_count(Pane::Ja), 3); // auto, JaMono, JaProp
+
+        press(&mut p, Key::ArrowDown);
+        press(&mut p, Key::ArrowDown);
+        assert_eq!(p.current.ja.as_ref().unwrap().name, "JaProp");
+        press(&mut p, Key::ArrowDown); // clamps at the end
+        assert_eq!(p.selected_row(Pane::Ja), Some(2));
+
+        // Hidden by the filter: the choice itself must survive
+        press(&mut p, Key::M);
+        assert_eq!(p.selected_row(Pane::Ja), None);
+        assert_eq!(p.current.ja.as_ref().unwrap().name, "JaProp");
+
+        press(&mut p, Key::Tab);
+        press(&mut p, Key::ArrowDown);
+        press(&mut p, Key::ArrowDown);
+        assert!(matches!(&p.current.ascii, AsciiChoice::Font(f) if f.name == "Latin"));
+        press(&mut p, Key::End);
+        assert!(matches!(&p.current.ascii, AsciiChoice::Font(f) if f.name == "JaMono"));
+        press(&mut p, Key::Home);
+        assert_eq!(p.current.ascii, AsciiChoice::Auto);
+        press(&mut p, Key::ArrowDown);
+        assert_eq!(p.current.ascii, AsciiChoice::SameAsJa);
+
+        press(&mut p, Key::Space);
+        assert!(!p.current.align_half);
+    }
+
+    #[test]
+    fn test_broken_font_keeps_previous_and_cancel_restores() {
+        let mut p = picker();
+        let ctx = egui::Context::default();
+        press(&mut p, Key::ArrowDown);
+        p.apply_if_changed(&ctx);
+        assert!(p.error.is_some());
+        assert_eq!(p.current, FontSet::default());
+        assert!(matches!(
+            press(&mut p, Key::Escape),
+            Some(PickerOutcome::Cancel(s)) if s == FontSet::default()
+        ));
+        assert!(matches!(press(&mut p, Key::Enter), Some(PickerOutcome::Accept(_))));
+    }
+
+    #[test]
+    fn test_opening_enter_does_not_close_the_picker() {
+        let mut p = picker();
+        let ctx = egui::Context::default();
+        let enter = egui::RawInput {
+            events: vec![Event::Key {
+                key: Key::Enter,
+                physical_key: None,
+                pressed: true,
+                repeat: false,
+                modifiers: egui::Modifiers::NONE,
+            }],
+            ..Default::default()
+        };
+        let mut first = None;
+        let _ = ctx.run(enter.clone(), |ctx| first = p.show(ctx));
+        assert!(first.is_none());
+        let mut second = None;
+        let _ = ctx.run(enter, |ctx| second = p.show(ctx));
+        assert!(matches!(second, Some(PickerOutcome::Accept(_))));
+    }
+}
