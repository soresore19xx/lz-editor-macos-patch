+/// Enumerate installed fonts that can serve as the Japanese font or the ASCII font.
+/// Takes a moment (parses every installed font), so call it from a worker thread.
+pub fn scan_fonts() -> Vec<FontEntry> {
+    let mut db = fontdb::Database::new();
+    db.load_system_fonts();
+
+    let mut entries: Vec<FontEntry> = Vec::new();
+    for info in db.faces() {
+        if info.style != fontdb::Style::Normal || info.post_script_name.starts_with('.') {
+            continue;
+        }
+        let path = match &info.source {
+            fontdb::Source::File(p) | fontdb::Source::SharedFile(p, _) => p.clone(),
+            fontdb::Source::Binary(_) => continue,
+        };
+        let family = info.families.first().map(|f| f.0.clone()).unwrap_or_default();
+        if family.starts_with('.') {
+            continue;
+        }
+        let parsed = db.with_face_data(info.id, |data, index| {
+            let face = Face::parse(data, index).ok()?;
+            let metrics = face_metrics(&face)?;
+            Some((metrics, face_display_name(&face)))
+        });
+        let Some((m, full_name)) = parsed.flatten() else {
+            continue;
+        };
+        let has_ja = m.ja_adv.is_some();
+        if !has_ja && !m.ascii_mono {
+            continue;
+        }
+        entries.push(FontEntry {
+            font: FontRef {
+                path,
+                index: info.index,
+                name: full_name.unwrap_or(family),
+            },
+            has_ja,
+            ascii_mono: m.ascii_mono,
+            ja_mono: m.ja_mono,
+        });
+    }
+    entries.sort_by(|a, b| {
+        (!a.ja_mono, &a.font.name, &a.font.path, a.font.index).cmp(&(
+            !b.ja_mono,
+            &b.font.name,
+            &b.font.path,
+            b.font.index,
+        ))
+    });
+    entries.dedup_by(|a, b| a.font.name == b.font.name);
+    entries
+}
+
+struct LoadedFace {
+    bytes: Vec<u8>,
+    index: u32,
+    metrics: FaceMetrics,
+}
+
+fn load_face(font: &FontRef) -> Result<LoadedFace, String> {
+    let mut bytes = std::fs::read(&font.path).map_err(|e| format!("{}: {e}", font.name))?;
+    zero_line_gap(&mut bytes, font.index);
+    let metrics = Face::parse(&bytes, font.index)
+        .ok()
+        .and_then(|face| face_metrics(&face))
+        .ok_or_else(|| format!("{}: 使えない形式のフォントです", font.name))?;
+    Ok(LoadedFace {
+        bytes,
+        index: font.index,
+        metrics,
+    })
+}
+
+/// Some fonts (e.g. Hiragino) declare a large line gap, which makes every row and button taller.
+/// LZ Editor has its own line height, so drop the gap from the in-memory copy.
+fn zero_line_gap(bytes: &mut [u8], index: u32) {
+    for (tag, field) in [(b"hhea", 8usize), (b"OS/2", 72usize)] {
+        if let Some(table) = table_offset(bytes, index, tag) {
+            if let Some(gap) = bytes.get_mut(table + field..table + field + 2) {
+                gap.fill(0);
             }
         }
     }
+}
+
+fn table_offset(bytes: &[u8], index: u32, tag: &[u8; 4]) -> Option<usize> {
+    let u16_at = |p: usize| Some(u16::from_be_bytes(bytes.get(p..p + 2)?.try_into().ok()?));
+    let u32_at = |p: usize| Some(u32::from_be_bytes(bytes.get(p..p + 4)?.try_into().ok()?));
+    let base = if bytes.starts_with(b"ttcf") {
+        u32_at(12 + 4 * index as usize)? as usize
+    } else {
+        0
+    };
+    let count = u16_at(base + 4)? as usize;
+    (0..count).find_map(|i| {
+        let record = base + 12 + 16 * i;
+        if bytes.get(record..record + 4)? != tag {
+            return None;
+        }
+        u32_at(record + 8).map(|o| o as usize)
+    })
+}
 
