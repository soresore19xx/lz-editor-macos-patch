diff --git a/src/font_picker.rs b/src/font_picker.rs
new file mode 100644
index 0000000..722edb7
--- /dev/null
+++ b/src/font_picker.rs
@@ -0,0 +1,563 @@
+// SPDX-License-Identifier: MIT
+// === Claude origin ===
+// Created/placed by Anthropic Claude Code at: 2026-11-25-195800
+// フォントセット (英数字 + 日本語) の選択画面。選択中の組をその場で反映し、Enter で確定・ESC で元に戻す
+// ====================
+use crate::app::{
+    BORDER_BLUE, FKEY_BTN_BG, FKEY_BTN_HOVER, STATUS_BADGE_BG, STATUS_BADGE_FG, STATUS_BG,
+    TEXT_AMBER, TEXT_CYAN, TEXT_DIM_CYAN, TEXT_WHITE,
+};
+use crate::fonts::{self, AsciiChoice, FontEntry, FontRef, FontSet};
+use eframe::egui::{
+    self, Align2, Color32, CornerRadius, Event, FontId, Key, Rect, Sense, Stroke, StrokeKind, Vec2,
+};
+use std::sync::mpsc::{self, Receiver, TryRecvError};
+use std::thread;
+
+const ROW_H: f32 = 22.0;
+const LIST_W: f32 = 330.0;
+const VISIBLE_ROWS: usize = 12;
+const ROW_SELECTED: Color32 = Color32::from_rgb(28, 82, 156);
+const LIST_BG: Color32 = Color32::from_rgb(8, 24, 56);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Pane {
+    Ascii,
+    Ja,
+}
+
+impl Pane {
+    fn other(self) -> Self {
+        match self {
+            Pane::Ascii => Pane::Ja,
+            Pane::Ja => Pane::Ascii,
+        }
+    }
+}
+
+pub enum PickerOutcome {
+    Accept(FontSet),
+    Cancel(FontSet),
+}
+
+pub struct FontPicker {
+    entries: Vec<FontEntry>,
+    scan: Option<Receiver<Vec<FontEntry>>>,
+    original: FontSet,
+    /// Selection being edited.
+    current: FontSet,
+    /// Last set successfully handed to egui.
+    applied: FontSet,
+    pane: Pane,
+    mono_only: bool,
+    error: Option<String>,
+    scroll_to_selection: bool,
+    just_opened: bool,
+}
+
+impl FontPicker {
+    pub fn open(current: &FontSet) -> Self {
+        let (tx, rx) = mpsc::channel();
+        thread::spawn(move || {
+            let _ = tx.send(fonts::scan_fonts());
+        });
+        let mut picker = Self::with_entries(current, Vec::new());
+        picker.scan = Some(rx);
+        picker
+    }
+
+    fn with_entries(current: &FontSet, entries: Vec<FontEntry>) -> Self {
+        Self {
+            entries,
+            scan: None,
+            original: current.clone(),
+            current: current.clone(),
+            applied: current.clone(),
+            pane: Pane::Ja,
+            mono_only: false,
+            error: None,
+            scroll_to_selection: true,
+            just_opened: true,
+        }
+    }
+
+    fn poll_scan(&mut self) {
+        let Some(rx) = &self.scan else {
+            return;
+        };
+        match rx.try_recv() {
+            Ok(entries) => {
+                self.entries = entries;
+                self.scan = None;
+                self.scroll_to_selection = true;
+            }
+            Err(TryRecvError::Disconnected) => {
+                self.scan = None;
+                self.error = Some("フォントの一覧を取得できませんでした".to_string());
+            }
+            Err(TryRecvError::Empty) => {}
+        }
+    }
+
+    // --- List model: each pane has fixed "auto" rows followed by installed fonts ---
+
+    fn fixed_rows(pane: Pane) -> &'static [&'static str] {
+        match pane {
+            Pane::Ascii => &["自動", "日本語フォントの英数字を使う"],
+            Pane::Ja => &["自動"],
+        }
+    }
+
+    fn pane_fonts(&self, pane: Pane) -> Vec<&FontEntry> {
+        let mut list: Vec<&FontEntry> = self
+            .entries
+            .iter()
+            .filter(|e| match pane {
+                Pane::Ascii => e.ascii_mono,
+                Pane::Ja => e.has_ja && (!self.mono_only || e.ja_mono),
+            })
+            .collect();
+        if pane == Pane::Ascii {
+            // Latin-only coding fonts first (stable sort keeps names ordered)
+            list.sort_by_key(|e| e.has_ja);
+        }
+        list
+    }
+
+    fn row_count(&self, pane: Pane) -> usize {
+        Self::fixed_rows(pane).len() + self.pane_fonts(pane).len()
+    }
+
+    /// Row of the current selection; `None` while it is hidden by the filter or not scanned yet.
+    fn selected_row(&self, pane: Pane) -> Option<usize> {
+        let find = |f: &FontRef| {
+            self.pane_fonts(pane)
+                .iter()
+                .position(|e| e.font.path == f.path && e.font.index == f.index)
+                .map(|i| i + Self::fixed_rows(pane).len())
+        };
+        match pane {
+            Pane::Ja => self.current.ja.as_ref().map_or(Some(0), find),
+            Pane::Ascii => match &self.current.ascii {
+                AsciiChoice::Auto => Some(0),
+                AsciiChoice::SameAsJa => Some(1),
+                AsciiChoice::Font(f) => find(f),
+            },
+        }
+    }
+
+    fn select_row(&mut self, pane: Pane, row: usize) {
+        let fixed = Self::fixed_rows(pane).len();
+        let font = row
+            .checked_sub(fixed)
+            .and_then(|i| self.pane_fonts(pane).get(i).map(|e| e.font.clone()));
+        match pane {
+            Pane::Ja => self.current.ja = font,
+            Pane::Ascii => {
+                self.current.ascii = match (row, font) {
+                    (_, Some(f)) => AsciiChoice::Font(f),
+                    (1, None) => AsciiChoice::SameAsJa,
+                    _ => AsciiChoice::Auto,
+                }
+            }
+        }
+    }
+
+    fn move_selection(&mut self, delta: isize) {
+        let count = self.row_count(self.pane);
+        let row = self.selected_row(self.pane).unwrap_or(0) as isize;
+        let next = (row + delta).clamp(0, count as isize - 1) as usize;
+        self.select_row(self.pane, next);
+        self.scroll_to_selection = true;
+    }
+
+    // --- Input ---
+
+    fn handle_keys(&mut self, ctx: &egui::Context) -> Option<PickerOutcome> {
+        let page = VISIBLE_ROWS as isize - 1;
+        for event in ctx.input(|i| i.events.clone()) {
+            match event {
+                // egui_winit turns Ctrl+X into Event::Cut on Linux/Windows
+                Event::Cut => self.move_selection(1),
+                Event::Key {
+                    key,
+                    pressed: true,
+                    modifiers,
+                    ..
+                } => {
+                    let ctrl = modifiers.ctrl || modifiers.command;
+                    match key {
+                        Key::ArrowUp => self.move_selection(-1),
+                        Key::ArrowDown => self.move_selection(1),
+                        Key::PageUp => self.move_selection(-page),
+                        Key::PageDown => self.move_selection(page),
+                        Key::Home => self.move_selection(isize::MIN / 2),
+                        Key::End => self.move_selection(isize::MAX / 2),
+                        Key::E if ctrl => self.move_selection(-1),
+                        Key::X if ctrl => self.move_selection(1),
+                        Key::R if ctrl => self.move_selection(-page),
+                        Key::C if ctrl => self.move_selection(page),
+                        Key::ArrowLeft => self.pane = Pane::Ascii,
+                        Key::ArrowRight => self.pane = Pane::Ja,
+                        Key::S if ctrl => self.pane = Pane::Ascii,
+                        Key::D if ctrl => self.pane = Pane::Ja,
+                        Key::Tab => self.pane = self.pane.other(),
+                        Key::Space => self.current.align_half = !self.current.align_half,
+                        Key::M if !ctrl => self.toggle_mono_only(),
+                        Key::Enter => return Some(self.accept()),
+                        Key::Escape => return Some(self.cancel(ctx)),
+                        _ => {}
+                    }
+                }
+                _ => {}
+            }
+        }
+        None
+    }
+
+    fn toggle_mono_only(&mut self) {
+        self.mono_only = !self.mono_only;
+        self.scroll_to_selection = true;
+    }
+
+    fn accept(&self) -> PickerOutcome {
+        PickerOutcome::Accept(self.applied.clone())
+    }
+
+    fn cancel(&self, ctx: &egui::Context) -> PickerOutcome {
+        if self.applied != self.original {
+            let _ = fonts::apply_or_auto(ctx, &self.original);
+        }
+        PickerOutcome::Cancel(self.original.clone())
+    }
+
+    fn apply_if_changed(&mut self, ctx: &egui::Context) {
+        if self.current == self.applied {
+            return;
+        }
+        match fonts::apply(ctx, &self.current) {
+            Ok(_) => {
+                self.applied = self.current.clone();
+                self.error = None;
+            }
+            Err(e) => {
+                // Keep the previous fonts and the previous selection.
+                self.current = self.applied.clone();
+                self.error = Some(e);
+            }
+        }
+    }
+
+    // --- Rendering ---
+
+    pub fn show(&mut self, ctx: &egui::Context) -> Option<PickerOutcome> {
+        ctx.output_mut(|o| o.ime = None);
+        self.poll_scan();
+        if self.scan.is_some() {
+            ctx.request_repaint_after(std::time::Duration::from_millis(50));
+        }
+
+        // The Enter that opened this window from the menu must not close it in the same frame.
+        let mut outcome = if std::mem::take(&mut self.just_opened) {
+            None
+        } else {
+            self.handle_keys(ctx)
+        };
+        if outcome.is_some() {
+            return outcome;
+        }
+
+        egui::Window::new("フォント設定")
+            .collapsible(false)
+            .resizable(false)
+            .anchor(Align2::RIGHT_BOTTOM, Vec2::new(-16.0, -48.0))
+            .frame(
+                egui::Frame::window(&ctx.style())
+                    .fill(STATUS_BG)
+                    .stroke(Stroke::new(1.5_f32, TEXT_CYAN))
+                    .inner_margin(egui::Margin::same(10)),
+            )
+            .show(ctx, |ui| {
+                let text = |s: &str, color| {
+                    egui::RichText::new(s)
+                        .font(FontId::monospace(12.5))
+                        .color(color)
+                };
+                ui.horizontal(|ui| {
+                    self.show_list(ui, Pane::Ascii, "英数字 (半角)");
+                    self.show_list(ui, Pane::Ja, "日本語 (全角)");
+                });
+                self.scroll_to_selection = false;
+
+                ui.add_space(4.0);
+                ui.label(text(
+                    "Ilo0O 123 {}[]; |あいう漢字ｶﾅ| ABCDEFGHIJ|12345|あいうえお",
+                    TEXT_WHITE,
+                ));
+                ui.add_space(4.0);
+                ui.horizontal(|ui| {
+                    if toggle(ui, "半角:全角=1:2 (Space)", self.current.align_half) {
+                        self.current.align_half = !self.current.align_half;
+                    }
+                    if toggle(ui, "等幅の日本語だけ (M)", self.mono_only) {
+                        self.toggle_mono_only();
+                    }
+                });
+                ui.add_space(4.0);
+                ui.horizontal(|ui| {
+                    if button(ui, "決定 (Enter)") {
+                        outcome = Some(self.accept());
+                    }
+                    if button(ui, "取消 (ESC)") {
+                        outcome = Some(self.cancel(ctx));
+                    }
+                    if button(ui, "自動に戻す") {
+                        self.current = FontSet::default();
+                        self.scroll_to_selection = true;
+                    }
+                    match &self.error {
+                        Some(e) => ui.label(text(e, TEXT_AMBER)),
+                        None if self.scan.is_some() => {
+                            ui.label(text("フォントを調べています...", TEXT_AMBER))
+                        }
+                        None => ui.label(text("↑↓ 選択  ←→ 切替", TEXT_DIM_CYAN)),
+                    };
+                });
+            });
+
+        if outcome.is_none() {
+            self.apply_if_changed(ctx);
+        }
+        outcome
+    }
+
+    fn show_list(&mut self, ui: &mut egui::Ui, pane: Pane, title: &str) {
+        let active = self.pane == pane;
+        let selected = self.selected_row(pane);
+        let count = self.row_count(pane);
+        let mut clicked = None;
+
+        ui.vertical(|ui| {
+            ui.label(
+                egui::RichText::new(title)
+                    .font(FontId::monospace(13.0))
+                    .color(if active { TEXT_CYAN } else { TEXT_DIM_CYAN }),
+            );
+            let frame = egui::Frame::NONE.fill(LIST_BG).stroke(Stroke::new(
+                1.0_f32,
+                if active { TEXT_CYAN } else { BORDER_BLUE },
+            ));
+            frame.show(ui, |ui| {
+                ui.spacing_mut().item_spacing = Vec2::ZERO;
+                let mut area = egui::ScrollArea::vertical()
+                    .id_salt(title)
+                    .auto_shrink([false, false])
+                    .max_height(ROW_H * VISIBLE_ROWS as f32)
+                    .min_scrolled_height(ROW_H * VISIBLE_ROWS as f32);
+                if self.scroll_to_selection {
+                    let row = selected.unwrap_or(0) as f32;
+                    let top = (row - (VISIBLE_ROWS / 2) as f32).max(0.0) * ROW_H;
+                    area = area.vertical_scroll_offset(top);
+                }
+                ui.set_width(LIST_W);
+                area.show_rows(ui, ROW_H, count, |ui, range| {
+                    let fonts = self.pane_fonts(pane);
+                    let fixed = Self::fixed_rows(pane);
+                    for row in range {
+                        let (rect, resp) =
+                            ui.allocate_exact_size(Vec2::new(LIST_W, ROW_H), Sense::CLICK);
+                        if resp.clicked() {
+                            clicked = Some(row);
+                        }
+                        let (name, mono) = match row.checked_sub(fixed.len()) {
+                            None => (fixed[row], false),
+                            Some(i) => (fonts[i].font.name.as_str(), fonts[i].ja_mono),
+                        };
+                        paint_row(ui, rect, name, mono, selected == Some(row), resp.hovered());
+                    }
+                });
+            });
+        });
+
+        if let Some(row) = clicked {
+            self.pane = pane;
+            self.select_row(pane, row);
+        }
+    }
+}
+
+fn paint_row(ui: &egui::Ui, rect: Rect, name: &str, mono: bool, selected: bool, hovered: bool) {
+    let painter = ui.painter_at(rect);
+    if selected {
+        painter.rect_filled(rect, CornerRadius::ZERO, ROW_SELECTED);
+    } else if hovered {
+        painter.rect_filled(rect, CornerRadius::ZERO, FKEY_BTN_BG);
+    }
+    painter.text(
+        rect.left_center() + Vec2::new(8.0, 0.0),
+        Align2::LEFT_CENTER,
+        name,
+        FontId::monospace(13.0),
+        TEXT_WHITE,
+    );
+    if mono {
+        painter.text(
+            rect.right_center() - Vec2::new(14.0, 0.0),
+            Align2::RIGHT_CENTER,
+            "等幅",
+            FontId::monospace(11.0),
+            TEXT_DIM_CYAN,
+        );
+    }
+}
+
+/// Click-only (never takes keyboard focus, so Space/Enter/Tab stay with the picker).
+fn button(ui: &mut egui::Ui, label: &str) -> bool {
+    clickable(ui, label, FKEY_BTN_BG, TEXT_WHITE)
+}
+
+fn toggle(ui: &mut egui::Ui, label: &str, on: bool) -> bool {
+    let (mark, bg, fg) = if on {
+        ("ON ", STATUS_BADGE_BG, STATUS_BADGE_FG)
+    } else {
+        ("OFF", FKEY_BTN_BG, TEXT_WHITE)
+    };
+    clickable(ui, &format!("{mark} {label}"), bg, fg)
+}
+
+fn clickable(ui: &mut egui::Ui, label: &str, bg: Color32, fg: Color32) -> bool {
+    let galley = ui.fonts(|f| f.layout_no_wrap(label.to_string(), FontId::monospace(12.5), fg));
+    let size = galley.size() + Vec2::new(16.0, 8.0);
+    let (rect, resp) = ui.allocate_exact_size(size, Sense::CLICK);
+    let fill = if resp.hovered() && bg == FKEY_BTN_BG {
+        FKEY_BTN_HOVER
+    } else {
+        bg
+    };
+    ui.painter().rect(
+        rect,
+        CornerRadius::same(3),
+        fill,
+        Stroke::new(1.0_f32, BORDER_BLUE),
+        StrokeKind::Inside,
+    );
+    ui.painter()
+        .galley(rect.min + Vec2::new(8.0, 4.0), galley, fg);
+    resp.clicked()
+}
