+// SPDX-License-Identifier: MIT
+// === Claude origin ===
+// Created/placed by Anthropic Claude Code at: 2026-11-25-195400
+// フォントセットの選択を OS 標準の設定フォルダに保存・復元する
+// ====================
+use crate::fonts::{AsciiChoice, FontRef, FontSet};
+use std::fs;
+use std::io;
+use std::path::{Path, PathBuf};
+
+const SETTINGS_FILE: &str = "settings.conf";
+
+/// Settings directory: `LZ_CONFIG_DIR` if set, otherwise the per-OS standard location.
+pub fn config_dir() -> Option<PathBuf> {
+    if let Some(dir) = std::env::var_os("LZ_CONFIG_DIR") {
+        if !dir.is_empty() {
+            return Some(PathBuf::from(dir));
+        }
+    }
+    let home = std::env::var_os("HOME").map(PathBuf::from)?;
+    #[cfg(target_os = "macos")]
+    {
+        Some(home.join("Library/Application Support/LZ Editor"))
+    }
+    #[cfg(not(target_os = "macos"))]
+    {
+        let base = std::env::var_os("XDG_CONFIG_HOME")
+            .map(PathBuf::from)
+            .filter(|p| p.is_absolute())
+            .unwrap_or_else(|| home.join(".config"));
+        Some(base.join("lz-editor"))
+    }
+}
+
+pub fn load() -> FontSet {
+    config_dir().map(|d| load_from(&d)).unwrap_or_default()
+}
+
+pub fn save(set: &FontSet) -> io::Result<PathBuf> {
+    let dir = config_dir()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "設定フォルダが見つかりません"))?;
+    save_to(&dir, set)
+}
+
+pub fn load_from(dir: &Path) -> FontSet {
+    let mut set = FontSet::default();
+    let Ok(text) = fs::read_to_string(dir.join(SETTINGS_FILE)) else {
+        return set;
+    };
+    for line in text.lines() {
+        let Some((key, value)) = line.split_once('=') else {
+            continue;
+        };
+        let value = value.trim();
+        match key.trim() {
+            "font.ja" => set.ja = decode_font(value),
+            "font.ascii" => {
+                set.ascii = match value {
+                    "same" => AsciiChoice::SameAsJa,
+                    _ => decode_font(value).map_or(AsciiChoice::Auto, AsciiChoice::Font),
+                }
+            }
+            "font.align_half" => set.align_half = value != "false",
+            _ => {}
+        }
+    }
+    set
+}
+
+pub fn save_to(dir: &Path, set: &FontSet) -> io::Result<PathBuf> {
+    fs::create_dir_all(dir)?;
+    let ascii = match &set.ascii {
+        AsciiChoice::Auto => "auto".to_string(),
+        AsciiChoice::SameAsJa => "same".to_string(),
+        AsciiChoice::Font(f) => encode_font(f),
+    };
+    let ja = set.ja.as_ref().map_or("auto".to_string(), encode_font);
+    let text = format!(
+        "# LZ Editor settings\nfont.ja={ja}\nfont.ascii={ascii}\nfont.align_half={}\n",
+        set.align_half
+    );
+    let path = dir.join(SETTINGS_FILE);
+    let tmp = dir.join(format!("{SETTINGS_FILE}.tmp"));
+    fs::write(&tmp, text)?;
+    fs::rename(&tmp, &path)?;
+    Ok(path)
+}
+
+/// `<face index>|<display name>|<path>` (the path comes last because it may contain `|`)
+fn encode_font(f: &FontRef) -> String {
+    let name = f.name.replace(['|', '\n', '\r'], " ");
+    format!("{}|{}|{}", f.index, name, f.path.display())
+}
+
+fn decode_font(value: &str) -> Option<FontRef> {
+    let mut parts = value.splitn(3, '|');
+    let index = parts.next()?.trim().parse().ok()?;
+    let name = parts.next()?.to_string();
+    let path = PathBuf::from(parts.next()?);
+    if path.as_os_str().is_empty() {
+        return None;
+    }
+    Some(FontRef { path, index, name })
+}
