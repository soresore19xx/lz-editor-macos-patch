+/// Metrics in em units. `None` if egui could not use the face (no outlines, broken tables, ...).
+fn face_metrics(face: &Face<'_>) -> Option<FaceMetrics> {
+    let upem = f32::from(face.units_per_em());
+    let ascent = f32::from(face.ascender()) / upem;
+    let descent = f32::from(face.descender()) / upem;
+    if ascent - descent <= 0.0 {
+        return None;
+    }
+
+    let advance = |c: char| -> Option<f32> {
+        let id = face.glyph_index(c)?;
+        Some(f32::from(face.glyph_hor_advance(id)?) / upem)
+    };
+    let has_outline = |c: char| -> bool {
+        struct Sink;
+        impl ttf_parser::OutlineBuilder for Sink {
+            fn move_to(&mut self, _: f32, _: f32) {}
+            fn line_to(&mut self, _: f32, _: f32) {}
+            fn quad_to(&mut self, _: f32, _: f32, _: f32, _: f32) {}
+            fn curve_to(&mut self, _: f32, _: f32, _: f32, _: f32, _: f32, _: f32) {}
+            fn close(&mut self) {}
+        }
+        face.glyph_index(c)
+            .and_then(|id| face.outline_glyph(id, &mut Sink))
+            .is_some()
+    };
+
+    let ascii_adv = advance('M').filter(|w| *w > 0.0 && has_outline('M'));
+    let ascii_mono = ascii_adv.is_some_and(|m| {
+        (' '..='~').all(|c| advance(c).is_some_and(|w| (w - m).abs() < 0.005))
+    });
+    let ja_adv = advance('あ').filter(|w| *w > 0.0 && has_outline('あ') && has_outline('ア'));
+    let ja_mono = ascii_mono
+        && matches!((ascii_adv, ja_adv), (Some(a), Some(j)) if (j - 2.0 * a).abs() < 0.01)
+        && advance('漢').is_some_and(|w| ja_adv.is_some_and(|j| (w - j).abs() < 0.005));
 
