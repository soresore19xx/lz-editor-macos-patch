+/// Install the font set into egui. On error nothing changes.
+pub fn apply(ctx: &egui::Context, set: &FontSet) -> Result<String, String> {
+    let (fonts, label) = build_definitions(set)?;
     ctx.set_fonts(fonts);
-    primary_loaded_path
