+/// Match the ASCII font to the Japanese font: 1:2 cell width and a shared baseline.
+fn ascii_tweak(ascii: &FaceMetrics, ja: &FaceMetrics, align_half: bool) -> FontTweak {
+    let scale = match (ascii.ascii_adv, ja.ja_adv) {
+        (Some(a), Some(j)) if align_half => (j * 0.5 / a).clamp(0.5, 1.5),
+        _ => 1.0,
+    };
+    // egui centers fallback fonts inside the first font's row, so the Japanese baseline is at:
+    let row_h = ascii.ascent - ascii.descent;
+    let ja_baseline = 0.5 * row_h + 0.5 * (ja.ascent + ja.descent);
+    // egui itself shifts scaled glyphs by (1 - scale) * 0.5 * (ascent + descent); undo that here.
+    let egui_shift = (1.0 - scale) * 0.5 * (ascii.ascent + ascii.descent);
+    FontTweak {
+        scale,
+        y_offset_factor: (ja_baseline - ascii.ascent + egui_shift) / (row_h * scale),
+        ..Default::default()
     }
+}
+
+fn to_font_data(face: LoadedFace, tweak: FontTweak) -> Arc<FontData> {
+    let mut data = FontData::from_owned(face.bytes);
+    data.index = face.index;
+    data.tweak = tweak;
+    Arc::new(data)
+}
 
+/// Build egui font definitions. Every face is validated first because egui panics on broken fonts.
+fn build_definitions(set: &FontSet) -> Result<(FontDefinitions, String), String> {
+    let auto_ja = auto_detect_ja();
+    let ja_ref = set.ja.clone().or_else(|| auto_ja.clone());
+    let ja = ja_ref.as_ref().map(load_face).transpose()?;
+
+    let ascii_ref = match &set.ascii {
+        AsciiChoice::Font(f) => Some(f.clone()),
+        AsciiChoice::SameAsJa => None,
+        AsciiChoice::Auto => match &ja {
+            Some(face) if !face.metrics.ascii_mono => auto_detect_ascii(),
+            _ => None,
+        },
+    };
+    let ascii = ascii_ref.as_ref().map(load_face).transpose()?;
+
+    let mut fonts = FontDefinitions::default();
+    let mut order: Vec<String> = Vec::new();
+    let mut add = |fonts: &mut FontDefinitions, key: &str, data: Arc<FontData>| {
+        fonts.font_data.insert(key.to_string(), data);
+        order.push(key.to_string());
+    };
+
+    let label = match (&ascii_ref, &ja_ref) {
+        (Some(a), Some(j)) => format!("{} + {}", a.name, j.name),
+        (None, Some(j)) => j.name.clone(),
+        (Some(a), None) => a.name.clone(),
+        (None, None) => "内蔵フォント".to_string(),
+    };
+
+    if let Some(face) = ascii {
+        let tweak = match &ja {
+            Some(ja) => ascii_tweak(&face.metrics, &ja.metrics, set.align_half),
+            None => FontTweak::default(),
+        };
+        add(&mut fonts, "lz_ascii", to_font_data(face, tweak));
+    }
+    if let Some(face) = ja {
+        add(&mut fonts, "lz_ja", to_font_data(face, FontTweak::default()));
+    }
+    // Keep the auto-detected font as a fallback when the chosen one lacks some glyphs.
+    if let Some(auto) = auto_ja.filter(|f| set.ja.as_ref().is_some_and(|j| j.path != f.path)) {
+        if let Ok(face) = load_face(&auto) {
+            add(&mut fonts, "lz_ja_fallback", to_font_data(face, FontTweak::default()));
+        }
+    }
+
+    for family in [FontFamily::Monospace, FontFamily::Proportional] {
+        let list = fonts.families.entry(family).or_default();
+        list.splice(0..0, order.iter().cloned());
+    }
+    Ok((fonts, label))
+}
